  "info": {
    "title": "Laforika Auth API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Request failed"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "PhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "example": "+989121234567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "ChallengeResponseDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "maskedDestination": {
            "type": "string"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "challengeId",
          "maskedDestination",
          "resendAvailableAt",
          "expiresAt"
        ]
      },
      "CodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "hasPhone": {
            "type": "boolean"
          },
          "hasEmail": {
            "type": "boolean"
          },
          "maskedPhone": {
            "type": "string",
            "nullable": true
          },
          "maskedEmail": {
            "type": "string",
            "nullable": true
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accountId",
          "hasPhone",
          "hasEmail",
          "accessToken",
          "refreshToken"
        ]
      },
      "EmailSignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailVerifyDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "EmailSignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResetChallengeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 15,
            "format": "password"
          }
        },
        "required": [
          "challengeId",
          "code",
          "newPassword"
        ]
      },
      "OkResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AccountViewDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "hasPhone": {
            "type": "boolean"
          },
          "hasEmail": {
            "type": "boolean"
          },
          "maskedPhone": {
            "type": "string",
            "nullable": true
          },
          "maskedEmail": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "accountId",
          "hasPhone",
          "hasEmail"
        ]
      },
      "AttachEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "minLength": 15,
            "format": "password"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "SessionListItemDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "deviceLabel": {
            "type": "string",
            "nullable": true
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "createdAt",
          "lastSeenAt",
          "isCurrent",
          "revoked"
        ]
      }
    }
  }
}
