  "info": {
    "title": "Laforika Auth API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Request failed"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "PhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "example": "+989121234567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "ChallengeResponseDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "maskedDestination": {
            "type": "string"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "challengeId",
          "maskedDestination",
          "resendAvailableAt",
          "expiresAt"
        ]
      },
      "CodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accountId",
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AccountViewDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accountId"
        ]
      },
      "SessionListItemDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "deviceLabel": {
            "type": "string",
            "nullable": true
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "createdAt",
          "lastSeenAt",
          "isCurrent",
          "revoked"
        ]
      },
      "OkResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "ProfileViewDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "example": "+989121234567"
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "phone",
          "phoneVerified",
          "emailVerified"
        ]
      },
      "PatchProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "description": "Omit to leave unchanged; null or blank clears."
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "description": "Omit to leave unchanged; null or blank clears."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email",
            "description": "Optional contact email. Omit unchanged; null or blank clears."
          }
        }
      }
    }
  }
}
