generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengePurpose {
  PHONE_SIGN_IN
}

enum DestinationType {
  PHONE
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phoneE164       String    @unique @map("phone_e164")
  firstName       String?   @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  emailNormalized String?   @unique @map("email_normalized")
  emailDisplay    String?   @map("email_display")
  emailVerifiedAt DateTime? @map("email_verified_at")
  disabledAt      DateTime? @map("disabled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  challenges AuthChallenge[]
  sessions   AuthSession[]
  events     SecurityEvent[]

  @@map("users")
}

model AuthChallenge {
  id                    String           @id @default(uuid()) @db.Uuid
  purpose               ChallengePurpose
  destinationType       DestinationType  @map("destination_type")
  destinationNormalized String           @map("destination_normalized")
  codeHash              String           @map("code_hash")
  attempts              Int              @default(0)
  maxAttempts           Int              @default(5) @map("max_attempts")
  expiresAt             DateTime         @map("expires_at")
  consumedAt            DateTime?        @map("consumed_at")
  userId                String?          @map("user_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationNormalized, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  deviceLabel       String?   @map("device_label")
  createdAt         DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([familyId])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  replacedById String?   @map("replaced_by_id") @db.Uuid
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  bucketKey   String   @unique @map("bucket_key")
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rate_limit_buckets")
}

model SecurityEvent {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  accountId    String?  @map("account_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  metadataJson Json     @default("{}") @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@map("security_events")
}
