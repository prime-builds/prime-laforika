# Laforika authentication backend — environment template.
#
# Copy to `.env` (development) and `.env.test` (integration tests) and fill in
# real local values. NEVER commit `.env`, `.env.*`, or the secrets/ directory.
# All values below are placeholders only.

# Runtime environment: dev | test | staging | prod
APP_ENVIRONMENT=dev

# HTTP port the API listens on.
PORT=3000

# PostgreSQL connection string. URL-encode reserved characters in the password
# (for example, encode `@` as `%40`).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/laforika_dev

# E2E / integration tests only: must match the database name in DATABASE_URL
# and end with `_test`. There is no silent rewrite — misconfiguration fails hard.
# Example for `.env.test`:
#   TEST_DATABASE_NAME=laforika_test
#   DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/laforika_test

# RS256 access-token signing identity.
JWT_ISSUER=https://auth.laforika.local
JWT_AUDIENCE=laforika-app
JWT_ACTIVE_KID=dev-1

# Paths to the RS256 key pair generated by `npm run keys:generate`.
# These files live under backend/secrets/ and are git-ignored.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Keyed secrets (long random hex). Generate with, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_PEPPER=replace-with-64-char-hex
OTP_CODE_PEPPER=replace-with-64-char-hex
RATE_LIMIT_PEPPER=replace-with-64-char-hex

# Trust X-Forwarded-For only behind a known reverse proxy. Default false.
TRUST_FORWARDED_ORIGIN=false

# Challenge delivery mode: fixture | unavailable
# - fixture: process-local inbox (dev/test only; requires FIXTURE_DELIVERY_ENABLED=true)
# - unavailable: fail-closed Unavailable* adapters (required for staging/prod until
#   real SMS/email adapters are configured — real adapters are not wired yet)
DELIVERY_MODE=fixture

# Development fixture delivery. MUST be false in staging and prod.
FIXTURE_DELIVERY_ENABLED=true
FIXTURE_INBOX_KEY=replace-with-random-hex

# Comma-separated CORS origins. Use `*` only for local development.
CORS_ORIGINS=*
